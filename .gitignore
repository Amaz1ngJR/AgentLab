# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Env
.env
.env.local

# Local machine-specific config (templates *.example.yaml are tracked)
config/mcp_servers.yaml
config/agents.yaml
config/app.yaml
config/control.yaml

# Playwright MCP runtime artifacts (console logs, page dumps)
.playwright-mcp/

# Browser profiles (contain login cookies/session — must never be committed)
data/browser-profiles/

# SQLite database (sessions/messages/memories/audit)
data/agentlab.db

# IDE
.vscode/
.idea/

# Project data
data/vector_store/

# Skills are personal/local — only the folder's README is tracked.
# (个人 Skill 不上传 GitHub；只保留 skills/README.md 作说明)
skills/*
!skills/README.md
!*.skill

#other
.DS_Store
