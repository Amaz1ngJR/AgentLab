# =========================================================
# AgentLab 配置
#
# 唯一配置入口：选一个 profile + 提供该 profile 需要的凭据。
# Profile 在 config/models.yaml 中定义。
# =========================================================

# ---------- 选择激活的 profile ----------
# 必填。可选值见 config/models.yaml：
#   cloud_claude_opus    - Anthropic Claude Opus
#   local_qwen           - 本机 Ollama + Qwen2.5-Coder 7B
#   local_qwen14b        - 本机 Ollama + Qwen2.5-Coder 14B
#   local_qwen3_14b      - 本机 Ollama + Qwen3 14B
#   lan_qwen             - 局域网 GPU 主机 Ollama
#   siliconflow          - 硅基流动 SiliconFlow（OpenAI 兼容云端）
#   aliyun_qwen          - 阿里云百炼 DashScope（OpenAI 兼容，Qwen 深度思考）
#   gpt_official         - OpenAI 官方 GPT 模型（GPT-5.5 / GPT-4）
#   crs_gpt              - CRS 网关 GPT-5.6-sol（内部网关）
ACTIVE_PROFILE=local_qwen3_14b

# ---------- OpenAI 凭据（gpt_official 使用）----------
# 填写您的 OpenAI API Key（不建议直接写在这里，建议使用环境变量）
OPENAI_API_KEY=your_openai_api_key_here

# ---------- CRS 网关凭据（crs_gpt 使用）----------
# 内部 CRS 网关 API key
# CRS_OAI_KEY=cr_xxxxxxxxxxxx
# CRS_OAI_URL=https://ai.vdian.net/openai

# ---------- Anthropic 凭据（cloud_claude / cloud_claude_opus 使用）----------
# 走自建代理 / Claude Code 网关时（Authorization: Bearer）：
# ANTHROPIC_AUTH_TOKEN=your_auth_token_here
# ANTHROPIC_BASE_URL=http://your.proxy.server:port
#
# 直连 Anthropic 官方时（x-api-key）：
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
#
# 覆盖 profile 里的模型 ID（可选）：
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- Ollama 凭据（local_* / lan_qwen 使用）----------
# Ollama 通常无需 API key；如有自定义代理可填：
# OLLAMA_API_KEY=your_ollama_api_key_here
# 可选：将 Ollama 模型保存在项目目录中；请按本机项目路径调整。
# local_qwen3_14b uses Ollama on http://127.0.0.1:11434/v1.
OLLAMA_MODELS=.\AgentLab\.ollama\qwen3-14b\models

# ---------- 硅基流动 SiliconFlow 凭据（siliconflow 使用）----------
# 控制台获取 API Key：https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
#
# 覆盖 profile 里的模型 ID（可选，用控制台里的完整名，带组织前缀）：
#   deepseek-ai/DeepSeek-V3 / Qwen/Qwen2.5-72B-Instruct / deepseek-ai/DeepSeek-R1
# SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# ---------- 阿里云百炼 DashScope 凭据（aliyun_qwen 使用）----------
# 控制台获取 API Key：https://bailian.console.aliyun.com/?apiKey=1
DASHSCOPE_API_KEY=your_dashscope_api_key_here
#
# 覆盖 profile 里的模型 ID（可选）：
#   qwen3.7-max / qwen-max / qwen-plus 等深度思考或对话模型
# DASHSCOPE_MODEL=qwen3.7-max
#
# 深度思考开关：aliyun_qwen profile 默认开启（展示推理过程）。
# 想临时关闭可设 LLM_ENABLE_THINKING=false。
# LLM_ENABLE_THINKING=

# ---------- 推理参数覆盖（可选，留空则用 profile 默认值）----------
LLM_TEMPERATURE=
LLM_TOP_P=
LLM_CONTEXT_SIZE=
LLM_TIMEOUT_SECONDS=120
LLM_STREAM=false

# ---------- Workspace 路径限制 ----------
# 文件工具(read_file / write_file / list_dir)只允许操作此目录下的路径。
# 留空则默认为项目根目录(开发期方便,生产场景请显式指定)。
# WORKSPACE_ROOT=/Users/you/projects/some-project

# ---------- 改动 diff 展示 ----------
# write_file 覆盖已有文件时,审批菜单前会打印彩色 diff(绿色新增 / 红色删除)。
# 若在 VS Code 集成终端里,还会额外拉起 VS Code 原生并排 diff 编辑器。
#   off/0/false : 关闭 VS Code diff(彩色 diff 仍打印)
#   on/1/true   : 只要 `code` CLI 可用就开启
#   留空(默认) : 仅当检测到 VS Code 集成终端(TERM_PROGRAM=vscode)时自动开启
# AGENTLAB_VSCODE_DIFF=
